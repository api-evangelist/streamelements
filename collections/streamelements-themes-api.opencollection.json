{
  "opencollection": "1.0.0",
  "info": {
    "name": "SE API Docs activities themes API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "themes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "/",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.streamelements.com/kappa/v2/themes",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "string - one of alert, regular, super mobile, widget"
              },
              {
                "name": "mobile",
                "value": "",
                "type": "query",
                "description": "boolean"
              }
            ]
          },
          "docs": "List available themes"
        },
        {
          "info": {
            "name": "/:themeId",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.streamelements.com/kappa/v2/themes/:themeId",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "themeId",
                "value": "",
                "type": "path",
                "description": "guid - theme id"
              }
            ]
          },
          "docs": "Get theme details"
        }
      ]
    }
  ],
  "bundled": true
}